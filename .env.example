# Configuration de backup.sh — un .env par serveur, jamais commité.
# Copier en `.env` à côté du script, puis `chmod 600 .env` (il contient une clé API).
#
# ⚠️ Toujours des chemins ABSOLUS : le service systemd tourne parfois en root,
# `~` y pointe vers /root et pas vers le home de l'utilisateur du serveur.

# --- Destination -----------------------------------------------------------
# Remote rclone + dossier racine sur le Drive. Le remote doit exister dans
# RCLONE_CONFIG (`rclone listremotes`).
RCLONE_REMOTE=gdrive-exemple:mon-serveur-backups

# Fichier de config rclone à utiliser. Utile quand le script tourne en root
# alors que le remote est authentifié dans le home d'un utilisateur normal.
RCLONE_CONFIG=/home/utilisateur/.config/rclone/rclone.conf

# --- Ce qui est sauvegardé -------------------------------------------------
# Dossier de code/docs : un tar.gz est produit ET une synchro incrémentale est
# poussée vers <RCLONE_REMOTE>/workspace-latest.
WORKSPACE_DIR=/home/utilisateur/workspace

# Motifs exclus du tar et de la synchro du dossier ci-dessus (séparés par des
# virgules). Défaut : .git,node_modules
BACKUP_EXCLUDE_PATTERNS=.git,node_modules,.venv,__pycache__,.next,dist,build

# Volumes Docker à NE PAS sauvegarder (globs acceptés, séparés par des
# virgules). Tous les autres volumes nommés sont pris automatiquement.
# À y mettre en priorité : les volumes de données Postgres, déjà couverts par
# les pg_dump et non portables entre versions de Postgres.
BACKUP_EXCLUDE_VOLUMES=*_pgdata,*postgres_data,*-db-data

# Chemins de configs critiques, un tar.gz par entrée (séparés par des
# virgules). Un chemin absent est signalé et sauté, pas une erreur.
BACKUP_CONFIG_PATHS=/etc/systemd/system,/etc/ufw,/home/utilisateur/.ssh

# Dossier de travail temporaire (doit avoir la place pour un tar du dossier
# de code). Défaut : /var/tmp/server-backup-gdrive
BACKUP_STAGING_DIR=/var/tmp/server-backup-gdrive

# --- Rétention GFS ---------------------------------------------------------
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=12

# --- Alertes (Resend) ------------------------------------------------------
# Sans clé, l'échec est seulement journalisé (visible via systemctl status).
RESEND_API_KEY=
ALERT_EMAIL_TO=moi@example.com
# Doit appartenir à un domaine vérifié dans Resend. `onboarding@resend.dev`
# (défaut) n'écrit qu'au titulaire du compte Resend — suffisant pour une
# alerte qui ne part qu'à soi-même.
ALERT_EMAIL_FROM=onboarding@resend.dev

# Nom du serveur affiché dans les mails. Défaut : `hostname -s`. À fixer
# explicitement pour matcher le SERVER_LABEL de server-security-audit
# (ex: Ghost, VPS-OVH) plutôt que de dépendre du hostname brut de la machine.
BACKUP_LABEL=
# Préfixe d'objet des mails. Défaut : [<BACKUP_LABEL>] [Backup].
# L'objet complet vaut « [Vps-ovh] [Backup] [✅ OK] — 2026-09-02 » : le verdict
# est encadré pour se repérer dans la liste des messages sans lire la fin.
#BACKUP_SUBJECT_PREFIX=[Ghost] [Backup]
# 1 = un mail à chaque run, succès compris (défaut). 0 = uniquement en cas d'échec.
BACKUP_MAIL_ON_SUCCESS=1
